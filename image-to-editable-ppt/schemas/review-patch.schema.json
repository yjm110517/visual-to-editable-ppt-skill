{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-patch.schema.json",
  "title": "Deterministic Review Patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "from_iteration", "to_iteration", "based_on_review_sha256", "based_on_review_evaluation_sha256", "preconditions", "operations", "preserved_elements"],
  "properties": {
    "schema_version": {"const": "1.3"},
    "task_id": {"type": "string", "minLength": 1},
    "from_iteration": {"type": "integer", "minimum": 1},
    "to_iteration": {"type": "integer", "minimum": 2},
    "based_on_review_sha256": {"$ref": "#/$defs/hash"},
    "based_on_review_evaluation_sha256": {"$ref": "#/$defs/hash"},
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_sha256", "crops_sha256", "asset_manifest_sha256"],
      "properties": {
        "layout_sha256": {"$ref": "#/$defs/hash"},
        "crops_sha256": {"$ref": "#/$defs/hash"},
        "asset_manifest_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "operations": {"type": "array", "minItems": 1, "items": {"oneOf": [
      {"$ref": "#/$defs/updateElement"}, {"$ref": "#/$defs/updateStyle"}, {"$ref": "#/$defs/recropAsset"},
      {"$ref": "#/$defs/replaceAsset"}, {"$ref": "#/$defs/reclassifyElement"}, {"$ref": "#/$defs/addElement"}, {"$ref": "#/$defs/removeElement"}
    ]}},
    "preserved_elements": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "base": {
      "type": "object",
      "properties": {
        "issue_id": {"type": "string", "minLength": 1},
        "override_reason": {"type": "string", "minLength": 1}
      },
      "required": ["issue_id"]
    },
    "updateElement": {
      "allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["issue_id", "type", "element_id", "changes"], "properties": {"issue_id": {"type": "string", "minLength": 1}, "type": {"const": "update_element"}, "element_id": {"$ref": "#/$defs/id"}, "changes": {"type": "object", "minProperties": 1}, "override_reason": {"type": "string", "minLength": 1}}}]
    },
    "updateStyle": {
      "allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["issue_id", "type", "style_id", "changes"], "properties": {"issue_id": {"type": "string", "minLength": 1}, "type": {"const": "update_style"}, "style_id": {"$ref": "#/$defs/id"}, "changes": {"type": "object", "minProperties": 1}, "override_reason": {"type": "string", "minLength": 1}}}]
    },
    "recropAsset": {
      "allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["issue_id", "type", "asset_id", "changes"], "properties": {"issue_id": {"type": "string", "minLength": 1}, "type": {"const": "recrop_asset"}, "asset_id": {"$ref": "#/$defs/id"}, "changes": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"box_px": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}], "minItems": 4, "maxItems": 4}, "padding_px": {"type": "integer", "minimum": 0}, "mode": {"enum": ["rgb", "rgba"]}, "remove_background": {"type": "boolean"}}}, "override_reason": {"type": "string", "minLength": 1}}}]
    },
    "replaceAsset": {
      "allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["issue_id", "type", "asset_id", "changes"], "properties": {"issue_id": {"type": "string", "minLength": 1}, "type": {"const": "replace_asset"}, "asset_id": {"$ref": "#/$defs/id"}, "changes": {"oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["replacement_asset_id"], "properties": {"replacement_asset_id": {"$ref": "#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["generated_svg"], "properties": {"generated_svg": {"type": "object", "additionalProperties": false, "required": ["filename", "content", "recolorable", "contains_text", "text_editability_exempt"], "properties": {"filename": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.svg$"}, "content": {"type": "string", "minLength": 1}, "recolorable": {"type": "boolean"}, "contains_text": {"type": "boolean"}, "text_editability_exempt": {"type": "boolean"}, "exemption_reason": {"type": "string", "minLength": 1}}}}}
      ]}, "override_reason": {"type": "string", "minLength": 1}}}]
    },
    "reclassifyElement": {
      "allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["issue_id", "type", "element_id", "changes"], "properties": {"issue_id": {"type": "string", "minLength": 1}, "type": {"const": "reclassify_element"}, "element_id": {"$ref": "#/$defs/id"}, "changes": {"type": "object", "additionalProperties": false, "required": ["replacement"], "properties": {"replacement": {"type": "object"}}}, "override_reason": {"type": "string", "minLength": 1}}}]
    },
    "addElement": {
      "allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["issue_id", "type", "changes"], "properties": {"issue_id": {"type": "string", "minLength": 1}, "type": {"const": "add_element"}, "changes": {"type": "object", "additionalProperties": false, "required": ["element"], "properties": {"element": {"type": "object"}}}, "override_reason": {"type": "string", "minLength": 1}}}]
    },
    "removeElement": {
      "allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["issue_id", "type", "element_id", "changes"], "properties": {"issue_id": {"type": "string", "minLength": 1}, "type": {"const": "remove_element"}, "element_id": {"$ref": "#/$defs/id"}, "changes": {"type": "object", "maxProperties": 0}, "override_reason": {"type": "string", "minLength": 1}}}]
    }
  }
}
