{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "render-report.schema.json",
  "title": "PPT Render Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "renderer", "renderer_version", "fallback_used", "width_px", "height_px", "rendered_page_count", "ppt_sha256", "render_sha256", "attempts", "warnings"],
  "properties": {
    "schema_version": {"const": "1.3"},
    "renderer": {"enum": ["Microsoft PowerPoint", "LibreOffice"]},
    "renderer_version": {"type": "string", "minLength": 1},
    "fallback_used": {"type": "boolean"},
    "width_px": {"type": "integer", "minimum": 1},
    "height_px": {"type": "integer", "minimum": 1},
    "rendered_page_count": {"const": 1},
    "ppt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "render_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["renderer", "status", "message"],
        "properties": {
          "renderer": {"enum": ["Microsoft PowerPoint", "LibreOffice"]},
          "status": {"enum": ["passed", "unavailable", "failed"]},
          "message": {"type": "string"}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
