{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-decision.schema.json",
  "title": "Delivery Gate Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "status", "accepted_iteration", "request_sha256", "qa_report_sha256", "review_report_sha256", "review_evaluation_sha256", "warnings", "approved_by", "decision_reasons", "timestamp_utc"],
  "properties": {
    "schema_version": {"const": "1.3"},
    "task_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["pass", "pass_with_warnings", "fail"]},
    "accepted_iteration": {"type": ["integer", "null"], "minimum": 1},
    "request_sha256": {"$ref": "#/$defs/hash"},
    "qa_report_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "review_report_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "review_evaluation_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "approved_by": {"enum": ["review_policy", "user", "acceptance_role"]},
    "decision_reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "approval": {"$ref": "#/$defs/responseEvidence"},
    "rejection": {"$ref": "#/$defs/responseEvidence"},
    "timestamp_utc": {"$ref": "#/$defs/timestamp"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]}, "then": {"properties": {"accepted_iteration": {"type": "integer", "minimum": 1}, "qa_report_sha256": {"$ref": "#/$defs/hash"}, "review_report_sha256": {"$ref": "#/$defs/hash"}, "review_evaluation_sha256": {"$ref": "#/$defs/hash"}, "approved_by": {"const": "review_policy"}, "warnings": {"maxItems": 0}}, "not": {"anyOf": [{"required": ["approval"]}, {"required": ["rejection"]}]}}},
    {"if": {"properties": {"status": {"const": "pass_with_warnings"}}, "required": ["status"]}, "then": {"required": ["approval"], "properties": {"accepted_iteration": {"type": "integer", "minimum": 1}, "qa_report_sha256": {"$ref": "#/$defs/hash"}, "review_report_sha256": {"$ref": "#/$defs/hash"}, "review_evaluation_sha256": {"$ref": "#/$defs/hash"}, "approved_by": {"enum": ["user", "acceptance_role"]}, "warnings": {"minItems": 1}}, "not": {"required": ["rejection"]}}},
    {"if": {"properties": {"status": {"const": "fail"}}, "required": ["status"]}, "then": {"properties": {"accepted_iteration": {"type": "null"}}, "not": {"required": ["approval"]}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "responseEvidence": {"type": "object", "additionalProperties": false, "required": ["message_sha256", "warning_candidate_sha256", "decision_at_utc"], "properties": {"message_sha256": {"$ref": "#/$defs/hash"}, "warning_candidate_sha256": {"$ref": "#/$defs/hash"}, "decision_at_utc": {"$ref": "#/$defs/timestamp"}}}
  }
}
