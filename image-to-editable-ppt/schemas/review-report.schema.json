{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-report.schema.json",
  "title": "Visual Review Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "iteration", "reviewer_recommendation", "scores", "issues", "mandatory_visual_checks", "approved_elements", "warnings", "review_context", "agent_provenance"],
  "properties": {
    "schema_version": {"const": "1.3"},
    "task_id": {"type": "string", "minLength": 1},
    "iteration": {"type": "integer", "minimum": 1},
    "reviewer_recommendation": {"enum": ["pass", "revise", "fail"]},
    "scores": {"$ref": "reviewer-response.schema.json#/$defs/scores"},
    "issues": {"type": "array", "items": {"$ref": "reviewer-response.schema.json#/$defs/issue"}},
    "mandatory_visual_checks": {"$ref": "reviewer-response.schema.json#/$defs/mandatory_visual_checks"},
    "approved_elements": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "review_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "render_sha256", "layout_sha256", "qa_report_sha256", "asset_manifest_sha256", "request_sha256", "review_rubric_sha256", "reviewer_response_schema_sha256", "reviewer_role_version"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/hash"},
        "render_sha256": {"$ref": "#/$defs/hash"},
        "layout_sha256": {"$ref": "#/$defs/hash"},
        "qa_report_sha256": {"$ref": "#/$defs/hash"},
        "asset_manifest_sha256": {"$ref": "#/$defs/hash"},
        "request_sha256": {"$ref": "#/$defs/hash"},
        "review_rubric_sha256": {"$ref": "#/$defs/hash"},
        "reviewer_response_schema_sha256": {"$ref": "#/$defs/hash"},
        "reviewer_role_version": {"type": "string", "pattern": "^1\\.3\\.[0-9]+$"}
      }
    },
    "agent_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planner", "reviewer", "review_rubric_sha256"],
      "properties": {
        "planner": {"$ref": "#/$defs/agent"},
        "reviewer": {"$ref": "#/$defs/agent"},
        "review_rubric_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_selection_mode", "requested_model", "config_sha256", "prompt_sha256", "temperature", "top_p", "seed", "call_id", "context_id", "parent_context_id"],
      "properties": {
        "model_selection_mode": {"enum": ["runtime-default", "explicit", "allowlist"]},
        "requested_model": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "config_sha256": {"$ref": "#/$defs/hash"},
        "prompt_sha256": {"$ref": "#/$defs/hash"},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "top_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "seed": {"type": ["integer", "null"]},
        "call_id": {"type": "string", "minLength": 1},
        "context_id": {"type": "string", "minLength": 1},
        "parent_context_id": {"type": "null"}
      }
    }
  }
}
