{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-report.schema.json",
  "title": "Structural QA Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "iteration", "hard_failures", "warnings", "metrics", "rendering", "provenance"],
  "properties": {
    "schema_version": {"const": "1.3"},
    "status": {"enum": ["pass", "fail"]},
    "iteration": {"type": "integer", "minimum": 1},
    "hard_failures": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slide_count", "required_text_count", "editable_required_text_count", "editable_text_ratio", "editable_text_status", "missing_required_native_objects", "invalid_text_exemptions", "expected_element_count", "built_element_count", "missing_element_ids", "unexpected_element_ids", "out_of_bounds_shapes", "missing_media", "font_violations", "rendered_page_count"],
      "properties": {
        "slide_count": {"type": "integer", "minimum": 0},
        "required_text_count": {"type": "integer", "minimum": 0},
        "editable_required_text_count": {"type": "integer", "minimum": 0},
        "editable_text_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "editable_text_status": {"enum": ["applicable", "not_applicable"]},
        "missing_required_native_objects": {"type": "integer", "minimum": 0},
        "invalid_text_exemptions": {"type": "integer", "minimum": 0},
        "expected_element_count": {"type": "integer", "minimum": 0},
        "built_element_count": {"type": "integer", "minimum": 0},
        "missing_element_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "unexpected_element_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "out_of_bounds_shapes": {"type": "integer", "minimum": 0},
        "missing_media": {"type": "integer", "minimum": 0},
        "font_violations": {"type": "integer", "minimum": 0},
        "rendered_page_count": {"type": "integer", "minimum": 0}
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer", "renderer_version", "fallback_used"],
      "properties": {
        "renderer": {"enum": ["Microsoft PowerPoint", "LibreOffice"]},
        "renderer_version": {"type": "string", "minLength": 1},
        "fallback_used": {"type": "boolean"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "request_sha256", "layout_sha256", "crops_sha256", "asset_manifest_sha256", "build_summary_sha256", "ppt_sha256", "render_sha256", "skill_version", "skill_revision", "builder", "builder_version", "python_version", "pillow_version", "python_pptx_version", "platform", "build_time_utc"],
      "properties": {
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "layout_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "crops_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "asset_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "build_summary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "ppt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "render_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "skill_version": {"const": "1.3"},
        "skill_revision": {"type": "string", "minLength": 1},
        "builder": {"const": "PptxGenJS"},
        "builder_version": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1},
        "pillow_version": {"type": "string", "minLength": 1},
        "python_pptx_version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "build_time_utc": {"type": "string", "format": "date-time"}
      }
    }
  }
}
