{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reviewer-response.schema.json",
  "title": "Visual Reviewer Raw Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "iteration", "reviewer_recommendation", "scores", "issues", "mandatory_visual_checks", "approved_elements", "warnings"],
  "properties": {
    "schema_version": {"const": "1.3"},
    "task_id": {"type": "string", "minLength": 1},
    "iteration": {"type": "integer", "minimum": 1},
    "reviewer_recommendation": {"enum": ["pass", "revise", "fail"]},
    "scores": {"$ref": "#/$defs/scores"},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "mandatory_visual_checks": {"$ref": "#/$defs/mandatory_visual_checks"},
    "approved_elements": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "$defs": {
    "visual_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "issue_ids"],
      "properties": {
        "status": {"enum": ["pass", "fail", "not_applicable"]},
        "rationale": {"type": "string", "minLength": 1},
        "issue_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "mandatory_visual_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector_topology",
        "connector_endpoints",
        "key_proportions",
        "crop_boundaries",
        "background_seams",
        "visual_depth",
        "typography_hierarchy"
      ],
      "properties": {
        "connector_topology": {"$ref": "#/$defs/visual_check"},
        "connector_endpoints": {"$ref": "#/$defs/visual_check"},
        "key_proportions": {"$ref": "#/$defs/visual_check"},
        "crop_boundaries": {"$ref": "#/$defs/visual_check"},
        "background_seams": {"$ref": "#/$defs/visual_check"},
        "visual_depth": {"$ref": "#/$defs/visual_check"},
        "typography_hierarchy": {"$ref": "#/$defs/visual_check"}
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_accuracy", "layout_similarity", "typography_similarity", "visual_style_similarity", "asset_quality"],
      "properties": {
        "content_accuracy": {"type": "integer", "minimum": 0, "maximum": 100},
        "layout_similarity": {"type": "integer", "minimum": 0, "maximum": 100},
        "typography_similarity": {"type": "integer", "minimum": 0, "maximum": 100},
        "visual_style_similarity": {"type": "integer", "minimum": 0, "maximum": 100},
        "asset_quality": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "w": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "h": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["update_element", "update_style", "recrop_asset", "replace_asset", "reclassify_element", "add_element", "remove_element", "request_better_source", "clarify_requirement", "no_action"]},
        "element_id": {"type": "string", "minLength": 1},
        "asset_id": {"type": "string", "minLength": 1},
        "changes": {"type": "object"}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "recoverability", "category", "element_ids", "asset_ids", "description", "recommended_action"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["critical", "major", "minor", "suggestion"]},
        "recoverability": {"enum": ["recoverable", "irrecoverable", "unknown"]},
        "category": {"enum": ["content", "layout", "typography", "style", "asset", "editability", "user_requirement"]},
        "element_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "asset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "source_region": {"$ref": "#/$defs/region"},
        "render_region": {"$ref": "#/$defs/region"},
        "description": {"type": "string", "minLength": 1},
        "recommended_action": {"$ref": "#/$defs/action"}
      }
    }
  }
}
