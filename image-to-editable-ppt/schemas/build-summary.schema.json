{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "build-summary.schema.json",
  "title": "PPT Build Summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "iteration", "hashes", "output_pptx", "expected_element_count", "built_element_count", "missing_element_ids", "unexpected_element_ids", "build_order", "element_map", "assets", "typography", "connections", "warnings"],
  "properties": {
    "schema_version": {"const": "1.3"},
    "run_id": {"type": "string", "minLength": 1},
    "iteration": {"type": "integer", "minimum": 1},
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_sha256", "asset_manifest_sha256", "output_pptx_sha256"],
      "properties": {
        "layout_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "asset_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "output_pptx_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "output_pptx": {"type": "string", "minLength": 1},
    "expected_element_count": {"type": "integer", "minimum": 0},
    "built_element_count": {"type": "integer", "minimum": 0},
    "missing_element_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unexpected_element_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "build_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "element_map": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["element_id", "type", "object_names", "object_count"],
        "properties": {
          "element_id": {"type": "string"},
          "type": {"enum": ["text", "shape", "line", "image"]},
          "object_names": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^ivt:"}, "uniqueItems": true},
          "object_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "type", "sha256"],
        "properties": {
          "asset_id": {"type": "string"},
          "type": {"enum": ["png", "jpeg", "svg"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_element_count", "run_count", "explicit_run_font_count", "inherited_run_font_count", "unresolved_font_count", "non_default_fit_elements", "font_resolutions"],
      "properties": {
        "text_element_count": {"type": "integer", "minimum": 0},
        "run_count": {"type": "integer", "minimum": 0},
        "explicit_run_font_count": {"type": "integer", "minimum": 0},
        "inherited_run_font_count": {"type": "integer", "minimum": 0},
        "unresolved_font_count": {"const": 0},
        "non_default_fit_elements": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "font_resolutions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["element_id", "run_index", "font_face", "font_size_pt", "source"],
            "properties": {
              "element_id": {"type": "string"},
              "run_index": {"type": "integer", "minimum": 0},
              "font_face": {"type": "string", "minLength": 1},
              "font_size_pt": {"type": "number", "exclusiveMinimum": 0},
              "source": {"enum": ["run", "element", "style"]}
            }
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["element_id", "from_id", "to_id"],
        "properties": {"element_id": {"type": "string"}, "from_id": {"type": ["string", "null"]}, "to_id": {"type": ["string", "null"]}}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
