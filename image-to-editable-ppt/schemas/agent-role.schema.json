{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-role.schema.json",
  "title": "Agent Role Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role_id", "role_version", "context_policy", "prompt_file", "output_schema", "parameters", "model_policy", "input_profiles", "forbidden_actions"],
  "properties": {
    "schema_version": {"const": "1.3"},
    "role_id": {"enum": ["layout-planner", "visual-reviewer"]},
    "role_version": {"type": "string", "pattern": "^1\\.[34]\\.[0-9]+$"},
    "context_policy": {"const": "fresh"},
    "prompt_file": {"type": "string", "pattern": "^prompts/[a-z0-9_-]+\\.md$"},
    "output_schema": {"type": "string", "pattern": "^\\.\\./schemas/[a-z0-9_-]+\\.schema\\.json$"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "top_p", "seed"],
      "properties": {
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "top_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "seed": {"type": ["integer", "null"]}
      }
    },
    "model_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_required", "required_capabilities"],
      "properties": {
        "runtime_required": {"const": true},
        "required_capabilities": {
          "type": "array",
          "items": {"enum": ["image-input", "structured-json"]},
          "minItems": 2,
          "uniqueItems": true
        }
      }
    },
    "input_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "minLength": 1},
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "forbidden_actions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
